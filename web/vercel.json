{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"$1.apk\""
        }
      ]
    }
  ]
}
